    <!-- JAVASCRIPT APPLICATION CORE LOGIC -->
    <script>
        // GLOBAL STATE
        window.currentSection = 'GEZI';
        window.currentViewMode = 'list';
        window.currentStatusFilter = 'ALL';
        window.currentCategoryFilter = 'ALL';
        window.currentCityFilter = 'ALL';
        window.currentDistrictFilter = 'ALL';
        window.searchQuery = '';
        window.currentAuthorRole = localStorage.getItem('gezelim_author_role') || 'Man';
        window.customRoomCode = localStorage.getItem('gezelim_room_code') || 'BIZIM-ODAMIZ';
        window.customSecurityPin = localStorage.getItem('gezelim_security_pin') || '123';
        window.pendingAction = null;
        window.leafletMapObj = null;
        window.leafletMarkers = [];

        // CATEGORIES DEFINITION
        const CATEGORIES = {
            GEZI: ['Müze', 'Orman', 'Piknik', 'Deniz', 'Seyir Tepesi', 'Tarihi Yapı', 'Park & Bahçe'],
            YEMEK: ['Restoran', 'Kafe & Tatlı', 'Sokak Lezzetleri', 'Meyhane & Bar', 'Kahvaltı']
        };

        // INITIAL PLACE DATA STORAGE
        let placesData = JSON.parse(localStorage.getItem('gezelim_places_v1')) || [
            {
                id: '1',
                title: 'Etoba Restoran',
                city: 'Tekirdağ',
                district: 'Süleymanpaşa',
                section: 'YEMEK',
                category: 'Restoran',
                status: 'GITTIM',
                author: 'Man',
                note: 'Köftesi ve etleri çok lezzetli, deniz manzaralı.',
                googleRating: 4.5,
                reviewCount: 4872,
                aiSummary: 'Kullanıcılar et lezzetini ve geniş mekan atmosferini beğeniyor.',
                museumCard: 'BILGI_YOK',
                nightMuseum: 'YOK',
                nightMuseumNote: '',
                lat: 40.9780,
                lng: 27.5110
            },
            {
                id: '2',
                title: 'Topkapı Sarayı Müzesi',
                city: 'İstanbul',
                district: 'Fatih',
                section: 'GEZI',
                category: 'Müze',
                status: 'GIDILMELI',
                author: 'Woman',
                note: 'Kutsal emanetler ve Harem dairesi mutlaka gezilmeli.',
                googleRating: 4.7,
                reviewCount: 65400,
                aiSummary: 'Tarihi atmosferi mükemmel, MüzeKart geçerlidir.',
                museumCard: 'GECERLI',
                nightMuseum: 'DONEMSEL',
                nightMuseumNote: 'Yaz sezonunda saat 22:00 ye kadar açık.',
                lat: 41.0115,
                lng: 28.9833
            }
        ];
        window.placesData = placesData;

        // INITIALIZE APP
        document.addEventListener('DOMContentLoaded', () => {
            checkProtocol();
            updateVersionDisplay();
            setAuthorRole(window.currentAuthorRole);
            updateRoomDisplay();
            populateCityDropdown();
            renderCategoryPills();
            updateCategoryDropdownOptions();
            renderPlaces();
            setupDraggableFab();
        });

        function updateRoomDisplay() {
            const badge = document.getElementById('displayRoomCode');
            if (badge) badge.innerText = window.customRoomCode;
        }

        function openSecuritySettingsModal() {
            document.getElementById('settingRoomCode').value = window.customRoomCode;
            document.getElementById('settingSecurityPin').value = window.customSecurityPin;
            document.getElementById('securitySettingsModal').classList.remove('hidden');
        }

        function closeSecuritySettingsModal() {
            document.getElementById('securitySettingsModal').classList.add('hidden');
        }

        function saveSecuritySettings() {
            const newRoom = document.getElementById('settingRoomCode').value.trim() || 'BIZIM-ODAMIZ';
            const newPin = document.getElementById('settingSecurityPin').value.trim() || '123';

            window.customRoomCode = newRoom.toUpperCase();
            window.customSecurityPin = newPin;

            localStorage.setItem('gezelim_room_code', window.customRoomCode);
            localStorage.setItem('gezelim_security_pin', window.customSecurityPin);

            updateRoomDisplay();
            closeSecuritySettingsModal();
            alert(`✅ Ayarlar kaydedildi!\n\n🔑 Oda Kodu: ${window.customRoomCode}\n🔒 Şifreniz Güncellendi.`);
        }

        function checkProtocol() {
            if (window.location.protocol === 'file:') {
                const banner = document.getElementById('fileProtocolWarning');
                if (banner) banner.classList.remove('hidden');
            }
        }

        function getAppVersion() {
            return localStorage.getItem('gezelim_app_version') || '0.1';
        }

        function incrementVersion() {
            let current = parseFloat(getAppVersion()) || 0.1;
            let next = Math.round((current + 0.1) * 10) / 10;
            let nextStr = next.toFixed(1);
            localStorage.setItem('gezelim_app_version', nextStr);
            updateVersionDisplay();
            return nextStr;
        }

        function updateVersionDisplay() {
            const badge = document.getElementById('appVersionBadge');
            if (badge) badge.innerText = `v${getAppVersion()}`;
        }

        function setAuthorRole(role) {
            window.currentAuthorRole = role;
            localStorage.setItem('gezelim_author_role', role);
            
            const btnMan = document.getElementById('btnAuthorMan');
            const btnWoman = document.getElementById('btnAuthorWoman');

            if (role === 'Man') {
                btnMan.className = "px-2.5 py-1 rounded-full font-bold transition-all bg-sky-500 text-white shadow-sm";
                btnWoman.className = "px-2.5 py-1 rounded-full font-bold transition-all text-slate-600";
            } else {
                btnMan.className = "px-2.5 py-1 rounded-full font-bold transition-all text-slate-600";
                btnWoman.className = "px-2.5 py-1 rounded-full font-bold transition-all bg-pink-500 text-white shadow-sm";
            }
        }

        function setMainSection(section) {
            window.currentSection = section;
            window.currentCategoryFilter = 'ALL';
            
            const btnGezi = document.getElementById('tabMainGezi');
            const btnYemek = document.getElementById('tabMainYemek');

            if (section === 'GEZI') {
                btnGezi.className = "py-1.5 rounded-lg text-center transition-all bg-indigo-600 text-white shadow-sm flex items-center justify-center gap-1";
                btnYemek.className = "py-1.5 rounded-lg text-center transition-all text-slate-600 flex items-center justify-center gap-1";
            } else {
                btnGezi.className = "py-1.5 rounded-lg text-center transition-all text-slate-600 flex items-center justify-center gap-1";
                btnYemek.className = "py-1.5 rounded-lg text-center transition-all bg-amber-500 text-white shadow-sm flex items-center justify-center gap-1";
            }

            renderCategoryPills();
            renderPlaces();
        }

        function setViewMode(mode) {
            window.currentViewMode = mode;
            const btnList = document.getElementById('btnViewList');
            const btnMap = document.getElementById('btnViewMap');
            const listView = document.getElementById('listView');
            const mapView = document.getElementById('mapView');

            if (mode === 'list') {
                btnList.className = "px-2.5 py-1.5 rounded-lg font-bold bg-white text-indigo-600 shadow-sm";
                btnMap.className = "px-2.5 py-1.5 rounded-lg font-bold text-slate-500";
                listView.classList.remove('hidden');
                mapView.classList.add('hidden');
            } else {
                btnList.className = "px-2.5 py-1.5 rounded-lg font-bold text-slate-500";
                btnMap.className = "px-2.5 py-1.5 rounded-lg font-bold bg-white text-indigo-600 shadow-sm";
                listView.classList.add('hidden');
                mapView.classList.remove('hidden');
                initOrUpdateMap();
            }
        }

        function renderCategoryPills() {
            const container = document.getElementById('subCategoryPills');
            const cats = CATEGORIES[window.currentSection];

            let html = `
                <button onclick="setCategoryFilter('ALL')" 
                    class="px-2.5 py-1 rounded-full font-bold whitespace-nowrap border transition-all ${window.currentCategoryFilter === 'ALL' ? 'bg-indigo-100 text-indigo-800 border-indigo-300' : 'bg-slate-50 text-slate-600 border-slate-200'}">
                    Tüm Kategoriler
                </button>
            `;

            cats.forEach(c => {
                const active = window.currentCategoryFilter === c;
                html += `
                    <button onclick="setCategoryFilter('${c}')" 
                        class="px-2.5 py-1 rounded-full font-bold whitespace-nowrap border transition-all ${active ? 'bg-indigo-600 text-white border-indigo-600' : 'bg-slate-50 text-slate-600 border-slate-200'}">
                        ${c}
                    </button>
                `;
            });

            container.innerHTML = html;
        }

        function setCategoryFilter(cat) {
            window.currentCategoryFilter = cat;
            renderCategoryPills();
            renderPlaces();
        }

        function setStatusFilter(status) {
            window.currentStatusFilter = status;
            ['ALL', 'GITTIM', 'GIDILMELI'].forEach(s => {
                const btn = document.getElementById(`btnStatus${s}`);
                if (s === status) {
                    btn.classList.add('ring-2', 'ring-indigo-500');
                } else {
                    btn.classList.remove('ring-2', 'ring-indigo-500');
                }
            });
            renderPlaces();
        }

        function populateCityDropdown() {
            const select = document.getElementById('citySelect');
            const cities = [...new Set(placesData.map(p => p.city).filter(Boolean))];
            
            let html = `<option value="ALL">🏙️ Şehir (Tümü)</option>`;
            cities.forEach(c => {
                html += `<option value="${c}">${c}</option>`;
            });
            select.innerHTML = html;
            populateDistrictDropdown();
        }

        function populateDistrictDropdown() {
            const select = document.getElementById('districtSelect');
            let filtered = placesData;
            if (window.currentCityFilter !== 'ALL') {
                filtered = placesData.filter(p => p.city === window.currentCityFilter);
            }
            const districts = [...new Set(filtered.map(p => p.district).filter(Boolean))];

            let html = `<option value="ALL">🏘️ İlçe (Tümü)</option>`;
            districts.forEach(d => {
                html += `<option value="${d}">${d}</option>`;
            });
            select.innerHTML = html;
        }

        function handleCityChange() {
            window.currentCityFilter = document.getElementById('citySelect').value;
            window.currentDistrictFilter = 'ALL';
            populateDistrictDropdown();
            renderPlaces();
        }

        function handleDistrictChange() {
            window.currentDistrictFilter = document.getElementById('districtSelect').value;
            renderPlaces();
        }

        function handleSearch() {
            window.searchQuery = document.getElementById('searchInput').value.toLowerCase();
            renderPlaces();
        }

        function renderPlaces() {
            const container = document.getElementById('listView');
            
            let filtered = placesData.filter(p => p.section === window.currentSection);

            if (window.currentCategoryFilter !== 'ALL') {
                filtered = filtered.filter(p => p.category === window.currentCategoryFilter);
            }

            if (window.currentStatusFilter !== 'ALL') {
                filtered = filtered.filter(p => p.status === window.currentStatusFilter);
            }

            if (window.currentCityFilter !== 'ALL') {
                filtered = filtered.filter(p => p.city === window.currentCityFilter);
            }

            if (window.currentDistrictFilter !== 'ALL') {
                filtered = filtered.filter(p => p.district === window.currentDistrictFilter);
            }

            if (window.searchQuery) {
                filtered = filtered.filter(p => 
                    p.title.toLowerCase().includes(window.searchQuery) ||
                    p.district.toLowerCase().includes(window.searchQuery) ||
                    p.city.toLowerCase().includes(window.searchQuery)
                );
            }

            document.getElementById('placeCounterBadge').innerText = `${filtered.length} Durak`;

            if (filtered.length === 0) {
                container.innerHTML = `
                    <div class="text-center py-12 bg-white rounded-2xl border border-dashed border-slate-200">
                        <div class="text-3xl mb-2">📍</div>
                        <p class="text-xs font-bold text-slate-500">Kayıtlı mekan bulunamadı.</p>
                        <button onclick="openAddPlaceModal()" class="mt-2 text-xs font-bold text-indigo-600 underline">Yeni Mekan Ekle</button>
                    </div>
                `;
                return;
            }

            let html = '';
            filtered.forEach(p => {
                const isMan = p.author === 'Man';
                const authorBadge = isMan 
                    ? `<span class="bg-sky-100 text-sky-800 text-[10px] font-bold px-2 py-0.5 rounded-full">👨 Man</span>`
                    : `<span class="bg-pink-100 text-pink-700 text-[10px] font-bold px-2 py-0.5 rounded-full">👩 Woman</span>`;

                const statusBadge = p.status === 'GITTIM'
                    ? `<span class="bg-emerald-100 text-emerald-800 text-[10px] font-bold px-2 py-0.5 rounded-full">🟢 Gittim</span>`
                    : `<span class="bg-amber-100 text-amber-800 text-[10px] font-bold px-2 py-0.5 rounded-full">📌 Gidilmeli</span>`;

                const isMuseum = p.category === 'Müze';
                let museumBadgeHtml = '';
                if (isMuseum) {
                    let mCardText = p.museumCard === 'GECERLI' ? '✅ MüzeKart Geçerli' : (p.museumCard === 'GECERSIZ' ? '❌ MüzeKart Geçersiz' : '❓ MüzeKart Bilgisi Yok');
                    let nightText = p.nightMuseum === 'VAR' ? '🌙 Gece Müzeciliği Var' : (p.nightMuseum === 'DONEMSEL' ? `🌙 Gece Müzeciliği: ${p.nightMuseumNote || 'Dönemsel'}` : '');
                    
                    museumBadgeHtml = `
                        <div class="mt-2 p-2 bg-indigo-50/70 rounded-xl text-[11px] font-bold text-indigo-900 border border-indigo-100/80 space-y-0.5">
                            <div>${mCardText}</div>
                            ${nightText ? `<div class="text-amber-700">${nightText}</div>` : ''}
                        </div>
                    `;
                }

                html += `
                    <div class="bg-white rounded-2xl p-3.5 border border-slate-200/90 shadow-sm space-y-2 relative">
                        <div class="flex items-start justify-between gap-2">
                            <div>
                                <div class="flex items-center gap-1.5 mb-1">
                                    <span class="bg-slate-100 text-slate-700 text-[10px] font-bold px-2 py-0.5 rounded-md">${p.category}</span>
                                    <span class="text-xs font-bold text-indigo-600">${p.district}, ${p.city}</span>
                                </div>
                                <h3 class="text-base font-bold text-slate-900 leading-snug">${p.title}</h3>
                            </div>
                            <div class="flex flex-col items-end gap-1">
                                ${statusBadge}
                                ${authorBadge}
                            </div>
                        </div>

                        ${p.note ? `<p class="text-xs text-slate-600 bg-slate-50 p-2 rounded-xl italic font-medium">"${p.note}"</p>` : ''}
                        ${museumBadgeHtml}

                        ${p.googleRating ? `
                            <div class="flex items-center gap-3 text-xs pt-1 border-t border-slate-100 font-bold">
                                <span class="text-amber-500 flex items-center gap-1">
                                    <i class="fa-solid fa-star"></i> ${p.googleRating}
                                    <span class="text-slate-400 font-normal">(${p.reviewCount || 0} Yorum)</span>
                                </span>
                            </div>
                        ` : ''}

                        ${p.aiSummary ? `
                            <p class="text-[11px] text-slate-500 font-medium leading-relaxed">
                                <i class="fa-solid fa-wand-magic-sparkles text-indigo-500"></i> ${p.aiSummary}
                            </p>
                        ` : ''}

                        <div class="flex items-center justify-between pt-2 border-t border-slate-100">
                            ${p.mapsUrl ? `
                                <a href="${p.mapsUrl}" target="_blank" class="text-xs font-bold text-indigo-600 flex items-center gap-1 hover:underline">
                                    <i class="fa-solid fa-location-dot"></i> Haritada Aç
                                </a>
                            ` : '<span></span>'}

                            <div class="flex items-center gap-2">
                                <button onclick="promptSecurityCheck('edit', '${p.id}')" class="w-7 h-7 bg-slate-100 text-slate-600 rounded-lg text-xs font-bold flex items-center justify-center">
                                    <i class="fa-solid fa-pen"></i>
                                </button>
                                <button onclick="promptSecurityCheck('delete', '${p.id}')" class="w-7 h-7 bg-rose-50 text-rose-600 rounded-lg text-xs font-bold flex items-center justify-center">
                                    <i class="fa-solid fa-trash"></i>
                                </button>
                            </div>
                        </div>
                    </div>
                `;
            });

            container.innerHTML = html;

            if (window.currentViewMode === 'map') {
                initOrUpdateMap();
            }
        }

        function initOrUpdateMap() {
            if (!window.leafletMapObj) {
                window.leafletMapObj = L.map('leafletMap').setView([41.0082, 28.9784], 10);
                L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png', {
                    maxZoom: 19,
                    attribution: '© OpenStreetMap'
                }).addTo(window.leafletMapObj);
            }

            window.leafletMarkers.forEach(m => window.leafletMapObj.removeLayer(m));
            window.leafletMarkers = [];

            let bounds = [];
            placesData.forEach(p => {
                if (p.lat && p.lng) {
                    const color = p.status === 'GITTIM' ? '#10b981' : '#f59e0b';
                    const customMarker = L.circleMarker([p.lat, p.lng], {
                        radius: 8,
                        fillColor: color,
                        color: '#ffffff',
                        weight: 2,
                        opacity: 1,
                        fillOpacity: 0.9
                    }).addTo(window.leafletMapObj);

                    customMarker.bindPopup(`
                        <div class="p-1 font-sans">
                            <b class="text-sm">${p.title}</b><br>
                            <span class="text-xs text-slate-500">${p.district}, ${p.city}</span>
                        </div>
                    `);

                    window.leafletMarkers.push(customMarker);
                    bounds.push([p.lat, p.lng]);
                }
            });

            if (bounds.length > 0) {
                window.leafletMapObj.fitBounds(bounds, { padding: [30, 30] });
            }
        }

        let autocompleteTimer = null;
        function handlePlaceNameInput(val) {
            clearTimeout(autocompleteTimer);
            const dropdown = document.getElementById('autocompleteDropdown');
            if (!val || val.length < 3) {
                dropdown.classList.add('hidden');
                return;
            }

            autocompleteTimer = setTimeout(() => {
                fetch(`https://nominatim.openstreetmap.org/search?format=json&q=${encodeURIComponent(val + ' Turkey')}&limit=5`)
                    .then(r => r.json())
                    .then(data => {
                        if (data && data.length > 0) {
                            let html = '';
                            data.forEach(item => {
                                const parts = item.display_name.split(',');
                                const title = parts[0];
                                const sub = parts.slice(1, 3).join(',');
                                html += `
                                    <div onclick="selectAutocomplete('${title.replace(/'/g, "\\'")}', '${item.lat}', '${item.lon}')" 
                                        class="p-2.5 hover:bg-indigo-50 cursor-pointer text-xs font-medium border-b border-slate-100 last:border-0">
                                        <div class="font-bold text-slate-800">${title}</div>
                                        <div class="text-[10px] text-slate-400">${sub}</div>
                                    </div>
                                `;
                            });
                            dropdown.innerHTML = html;
                            dropdown.classList.remove('hidden');
                        } else {
                            dropdown.classList.add('hidden');
                        }
                    }).catch(() => dropdown.classList.add('hidden'));
            }, 300);
        }

        function selectAutocomplete(title, lat, lng) {
            document.getElementById('placeTitle').value = title;
            document.getElementById('placeLat').value = lat;
            document.getElementById('placeLng').value = lng;
            document.getElementById('autocompleteDropdown').classList.add('hidden');
            triggerGeminiAiFetch();
        }

        window.triggerGeminiAiFetch = function() {
            const title = document.getElementById('placeTitle').value;
            if (!title) {
                alert('Lütfen önce mekan adını yazınız.');
                return;
            }

            document.getElementById('placeGoogleRating').value = "4.6";
            document.getElementById('placeReviewCount').value = "1250";
            document.getElementById('placeAiSummary').value = `Gemini AI: "${title}" hakkında kullanıcı yorumları oldukça olumlu. Atmosphere ve ulaşım kolaylığı öne çıkıyor.`;
            
            if (title.toLowerCase().includes('müze') || title.toLowerCase().includes('saray')) {
                document.getElementById('placeMuseumCard').value = "GECERLI";
                document.getElementById('placeNightMuseum').value = "DONEMSEL";
                document.getElementById('placeNightMuseumNote').value = "Yazın 22:00 ye kadar açık";
            }

            alert(`✨ "${title}" bilgileri Gemini AI tarafından çekildi ve form dolduruldu!`);
        };

        function toggleFabMenu() {
            const menu = document.getElementById('fabSubMenu');
            const icon = document.getElementById('mainFabIcon');

            if (menu.classList.contains('hidden')) {
                menu.classList.remove('hidden');
                setTimeout(() => {
                    menu.classList.remove('opacity-0', 'scale-90');
                }, 10);
                icon.className = "fa-solid fa-xmark rotate-90 transition-transform duration-300";
            } else {
                menu.classList.add('opacity-0', 'scale-90');
                setTimeout(() => {
                    menu.classList.add('hidden');
                }, 200);
                icon.className = "fa-solid fa-plus transition-transform duration-300";
            }
        }

        function setupDraggableFab() {
            const fab = document.getElementById('fabContainer');
            let isDragging = false;
            let currentX, currentY, initialX, initialY, xOffset = 0, yOffset = 0;

            fab.addEventListener('touchstart', dragStart, { passive: false });
            fab.addEventListener('touchend', dragEnd, { passive: false });
            fab.addEventListener('touchmove', drag, { passive: false });

            function dragStart(e) {
                if (e.target.closest('button') && !e.target.closest('#mainFabBtn')) return;
                initialX = e.touches[0].clientX - xOffset;
                initialY = e.touches[0].clientY - yOffset;
                isDragging = true;
            }

            function dragEnd() {
                initialX = currentX;
                initialY = currentY;
                isDragging = false;
            }

            function drag(e) {
                if (isDragging) {
                    e.preventDefault();
                    currentX = e.touches[0].clientX - initialX;
                    currentY = e.touches[0].clientY - initialY;
                    xOffset = currentX;
                    yOffset = currentY;
                    fab.style.transform = `translate3d(${currentX}px, ${currentY}px, 0)`;
                }
            }
        }

        window.shareViaWhatsApp = function() {
            try {
                const nextVer = incrementVersion();
                let shareUrl = window.location.href;
                
                if (window.location.protocol === 'file:') {
                    alert("⚠️ Yerel dosya modundasınız. WhatsApp ile canlı senkronizasyon için lütfen Web Linki (URL) kullanınız.");
                }

                const message = `Gezelim Görelim (v${nextVer}) Ortak gezi ve mekan listemize katıl! 🗺️✨\n\n${shareUrl}`;
                const encodedText = encodeURIComponent(message);
                
                const waUrl = `https://api.whatsapp.com/send?text=${encodedText}`;
                const a = document.createElement('a');
                a.href = waUrl;
                a.target = '_blank';
                a.rel = 'noopener noreferrer';
                document.body.appendChild(a);
                a.click();
                setTimeout(() => { if (a.parentNode) a.parentNode.removeChild(a); }, 100);
            } catch(err) {
                alert("WhatsApp bağlantısı açılamadı.");
            }
        };

        function triggerRandomPlacePicker() {
            toggleFabMenu();
            const filtered = placesData.filter(p => p.section === window.currentSection);
            if (filtered.length === 0) {
                alert("Öneri için seçili menüde mekan yok!");
                return;
            }
            const random = filtered[Math.floor(Math.random() * filtered.length)];
            alert(`🎲 Bugün Ne Denedenilsin?\n\n✨ ${random.title}\n📍 ${random.district}, ${random.city}\n⭐ Puan: ${random.googleRating || 'Yeni'}`);
        }

        function openAddPlaceModal() {
            promptSecurityCheck('add', null);
        }

        function closePlaceModal() {
            document.getElementById('placeModal').classList.add('hidden');
        }

        function updateCategoryDropdownOptions() {
            const sec = document.getElementById('placeSection').value;
            const select = document.getElementById('placeCategory');
            const cats = CATEGORIES[sec];
            let html = '';
            cats.forEach(c => {
                html += `<option value="${c}">${c}</option>`;
            });
            select.innerHTML = html;
        }

        async function handlePlaceSubmit(e) {
            e.preventDefault();
            const editId = document.getElementById('editPlaceId').value;
            const category = document.getElementById('placeCategory').value;
            const isMuseum = category === 'Müze';

            const newPlace = {
                id: editId || Date.now().toString(),
                title: document.getElementById('placeTitle').value,
                city: document.getElementById('placeCity').value,
                district: document.getElementById('placeDistrict').value,
                section: document.getElementById('placeSection').value,
                category: category,
                status: document.getElementById('placeStatus').value,
                author: window.currentAuthorRole,
                note: document.getElementById('placeNote').value,
                mapsUrl: document.getElementById('placeMapsUrl').value,
                googleRating: document.getElementById('placeGoogleRating').value || null,
                reviewCount: document.getElementById('placeReviewCount').value || null,
                aiSummary: document.getElementById('placeAiSummary').value || null,
                museumCard: isMuseum ? document.getElementById('placeMuseumCard').value : 'BILGI_YOK',
                nightMuseum: isMuseum ? document.getElementById('placeNightMuseum').value : 'YOK',
                nightMuseumNote: isMuseum ? document.getElementById('placeNightMuseumNote').value : '',
                lat: parseFloat(document.getElementById('placeLat').value) || null,
                lng: parseFloat(document.getElementById('placeLng').value) || null
            };

            if (editId) {
                const idx = placesData.findIndex(p => p.id === editId);
                if (idx !== -1) placesData[idx] = newPlace;
            } else {
                placesData.unshift(newPlace);
            }

            if (typeof window.savePlaceToCloud === 'function') {
                await window.savePlaceToCloud(newPlace);
            }

            localStorage.setItem('gezelim_places_v1', JSON.stringify(placesData));
            populateCityDropdown();
            setMainSection(newPlace.section);
            closePlaceModal();
        }

        function promptSecurityCheck(action, id) {
            window.pendingAction = { action, id };
            document.getElementById('securityPasswordInput').value = '';
            document.getElementById('passwordModal').classList.remove('hidden');
        }

        function closePasswordModal() {
            document.getElementById('passwordModal').classList.add('hidden');
            window.pendingAction = null;
        }

        async function submitPasswordVerification() {
            const pass = document.getElementById('securityPasswordInput').value;
            if (pass !== window.customSecurityPin) {
                alert('❌ Hatalı şifre! Lütfen ortak şifrenizi giriniz.');
                return;
            }

            const { action, id } = window.pendingAction;
            closePasswordModal();

            if (action === 'add') {
                document.getElementById('modalTitle').innerText = "✨ Yeni Durak Ekle";
                document.getElementById('editPlaceId').value = "";
                document.getElementById('placeForm').reset();
                updateCategoryDropdownOptions();
                document.getElementById('placeModal').classList.remove('hidden');
                if (!document.getElementById('fabSubMenu').classList.contains('hidden')) toggleFabMenu();
            } else if (action === 'delete') {
                placesData = placesData.filter(p => p.id !== id);
                if (typeof window.deletePlaceFromCloud === 'function') {
                    await window.deletePlaceFromCloud(id);
                }
                localStorage.setItem('gezelim_places_v1', JSON.stringify(placesData));
                populateCityDropdown();
                renderPlaces();
            } else if (action === 'edit') {
                const p = placesData.find(item => item.id === id);
                if (p) {
                    document.getElementById('modalTitle').innerText = "✏️ Durağı Düzenle";
                    document.getElementById('editPlaceId').value = p.id;
                    document.getElementById('placeTitle').value = p.title;
                    document.getElementById('placeCity').value = p.city;
                    document.getElementById('placeDistrict').value = p.district;
                    document.getElementById('placeSection').value = p.section;
                    updateCategoryDropdownOptions();
                    document.getElementById('placeCategory').value = p.category;
                    document.getElementById('placeStatus').value = p.status;
                    document.getElementById('placeNote').value = p.note || '';
                    document.getElementById('placeMapsUrl').value = p.mapsUrl || '';
                    document.getElementById('placeLat').value = p.lat || '';
                    document.getElementById('placeLng').value = p.lng || '';
                    document.getElementById('placeModal').classList.remove('hidden');
                }
            }
        }

        function openUserGuideModal() {
            if (!document.getElementById('fabSubMenu').classList.contains('hidden')) toggleFabMenu();
            document.getElementById('userGuideModal').classList.remove('hidden');
        }

        function closeUserGuideModal() {
            document.getElementById('userGuideModal').classList.add('hidden');
        }
    </script>
</body>
