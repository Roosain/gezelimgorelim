    <!-- BULUT CANLI SENKRONİZASYON MOTORU -->
    <script type="module">
        import { initializeApp } from "https://www.gstatic.com/firebasejs/11.6.1/firebase-app.js";
        import { getAuth, signInAnonymously, signInWithCustomToken, onAuthStateChanged } from "https://www.gstatic.com/firebasejs/11.6.1/firebase-auth.js";
        import { getFirestore, doc, setDoc, deleteDoc, onSnapshot, collection } from "https://www.gstatic.com/firebasejs/11.6.1/firebase-firestore.js";

        const appId = typeof __app_id !== 'undefined' ? __app_id : 'gezelim-gorelim-pwa';
        const firebaseConfig = typeof __firebase_config !== 'undefined' && __firebase_config 
            ? JSON.parse(__firebase_config) 
            : null;

        let db = null;
        let auth = null;
        let currentUser = null;

        async function initCloudSync() {
            if (!firebaseConfig) {
                console.log("⚠️ Yerel Mod: Ortak canlı senkronizasyon için web adresi (URL) bağlantısı üzerinden açılmalıdır.");
                return;
            }
            try {
                const app = initializeApp(firebaseConfig);
                db = getFirestore(app);
                auth = getAuth(app);

                const initialToken = typeof __initial_auth_token !== 'undefined' ? __initial_auth_token : null;
                if (initialToken) {
                    await signInWithCustomToken(auth, initialToken);
                } else {
                    await signInAnonymously(auth);
                }

                onAuthStateChanged(auth, (user) => {
                    if (user) {
                        currentUser = user;
                        listenToCloudPlaces();
                    }
                });
            } catch (err) {
                console.error("Canlı veritabanı bağlantı hatası:", err);
            }
        }

        function listenToCloudPlaces() {
            if (!db || !currentUser) return;
            const placesCol = collection(db, 'artifacts', appId, 'public', 'data', 'places');
            
            onSnapshot(placesCol, (snapshot) => {
                const cloudPlaces = [];
                snapshot.forEach((docSnap) => {
                    cloudPlaces.push(docSnap.data());
                });
                if (cloudPlaces.length > 0) {
                    window.placesData = cloudPlaces;
                    localStorage.setItem('gezelim_places_v1', JSON.stringify(cloudPlaces));
                }
                if (typeof window.populateCityDropdown === 'function') window.populateCityDropdown();
                if (typeof window.renderPlaces === 'function') window.renderPlaces();
            }, (error) => {
                console.error("Canlı senkronizasyon hatası:", error);
            });
        }

        window.savePlaceToCloud = async function(place) {
            if (db && currentUser) {
                try {
                    const placeDoc = doc(db, 'artifacts', appId, 'public', 'data', 'places', place.id);
                    await setDoc(placeDoc, place);
                    return true;
                } catch (e) {
                    console.error("Buluta yazma hatası:", e);
                }
            }
            return false;
        };

        window.deletePlaceFromCloud = async function(placeId) {
            if (db && currentUser) {
                try {
                    const placeDoc = doc(db, 'artifacts', appId, 'public', 'data', 'places', placeId);
                    await deleteDoc(placeDoc);
                    return true;
                } catch (e) {
                    console.error("Buluttan silme hatası:", e);
                }
            }
            return false;
        };

        initCloudSync();
    </script>

